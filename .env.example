# Reserved for the Supabase milestone. Supabase is not connected yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase key. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only credential encryption key. Generate a cryptographically random key.
# Keep it in your deployment secret manager; never commit the real value.
CREDENTIAL_ENCRYPTION_KEY=

# Application (validated by lib/env.ts)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
