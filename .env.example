# Public Supabase project configuration. These values may be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Application (validated by lib/env.ts)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
